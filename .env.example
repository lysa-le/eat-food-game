# Copy this file to .env.local and fill in the values from your Firebase
# project (Console -> Project settings -> General -> Your apps -> Web app
# -> SDK setup and configuration -> Config). .env.local is already
# gitignored (via the *.local pattern).
#
# Leaving these unset is fine — the game falls back to the local-only
# leaderboard, and the "Global" board simply doesn't appear.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
