rules_version = '2';

// The game's Firebase web config ships in the public site bundle (all
// Firebase web apps work this way), so these rules are what protect the
// leaderboard. Shape must match submitGlobalScore in
// src/game/globalLeaderboard.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidScore(data) {
      return data.keys().hasOnly(['initials', 'score', 'mode', 'createdAt'])
        && data.keys().hasAll(['initials', 'score', 'mode', 'createdAt'])
        && data.initials is string
        && data.initials.size() <= 3
        && data.score is int
        && data.score >= 0
        // The board shows 6 digits (formatScore).
        && data.score <= 999999
        && data.mode in ['solo', 'together', 'versus']
        // serverTimestamp() — clients can't backdate or forge it.
        && data.createdAt == request.time;
    }

    match /scores/{scoreId} {
      // Leaderboard reads: one doc or a small top-N query.
      allow get: if true;
      allow list: if request.query.limit <= 50;

      // New scores only; nobody can edit or delete an entry.
      allow create: if isValidScore(request.resource.data);
      allow update, delete: if false;
    }

    // Online 2 Player rooms (src/game/onlineRoom.ts). The room ID is a
    // long random string in the shared link, so knowing it is what lets
    // someone join. Only rooms long past expiry can be listed or deleted
    // — that's the in-game cleanup, since TTL policies need billing.
    match /rooms/{roomId} {
      allow get: if true;
      allow list: if isLongExpired(resource.data)
        && request.query.limit <= 10;
      allow create: if isValidNewRoom(roomId, request.resource.data);
      allow update: if isValidRoomUpdate(resource.data, request.resource.data);
      allow delete: if isLongExpired(resource.data);

      // Each player's live score/lives/level during a game, shown in the
      // other phone's Friend box. Written only while the game is running.
      match /players/{role} {
        allow get: if true;
        allow list: if false;
        allow create, update: if role in ['host', 'guest']
          && roomData(roomId).status == 'started'
          && isValidPlayerState(request.resource.data)
          && request.resource.data.round == roomData(roomId).round;
        // Cleanup clears these before deleting their long-expired room.
        allow delete: if isLongExpired(roomData(roomId));
      }
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isValidPlayerState(data) {
      return data.keys().hasOnly(['score', 'lives', 'level', 'out', 'round', 'updatedAt'])
        && data.keys().hasAll(['score', 'lives', 'level', 'out', 'round', 'updatedAt'])
        && data.score is int && data.score >= 0 && data.score <= 999999
        && data.lives is int && data.lives >= 0 && data.lives <= 3
        && data.level is int && data.level >= 1 && data.level <= 1000
        && data.out is bool
        && data.round is int && data.round >= 1
        && data.updatedAt == request.time;
    }

    function isLongExpired(room) {
      return room.expiresAt < request.time - duration.value(24, 'h');
    }

    function isValidNewRoom(roomId, data) {
      return roomId.size() >= 16
        && data.keys().hasOnly(['status', 'createdAt', 'expiresAt'])
        && data.keys().hasAll(['status', 'createdAt', 'expiresAt'])
        && data.status == 'waiting'
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(7, 'h');
    }

    // waiting <-> ready (friend joins/leaves), ready -> started (host
    // presses Start: round 1, stamped with server time), Play Again taps
    // and the next round once both tapped, anything -> closed. Only
    // closing is allowed once a room has expired.
    function isValidRoomUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      let from = before.status;
      let to = after.status;
      let open = before.expiresAt > request.time;
      let playing = open && from == 'started' && to == 'started';
      return (
          open && from == 'ready' && to == 'started'
          && changed.hasOnly(['status', 'startedAt', 'round'])
          && after.startedAt == request.time
          && after.round == 1
        ) || (
          // A player taps Play Again.
          playing && (
            (changed.hasOnly(['hostAgain']) && after.hostAgain == true)
            || (changed.hasOnly(['guestAgain']) && after.guestAgain == true)
          )
        ) || (
          // Both tapped: the next round (one at a time), taps cleared.
          playing
          && changed.hasOnly(['round', 'startedAt', 'hostAgain', 'guestAgain'])
          && before.hostAgain == true && before.guestAgain == true
          && after.round == before.round + 1
          && after.hostAgain == false && after.guestAgain == false
          && after.startedAt == request.time
        ) || (
          changed.hasOnly(['status'])
          && (
            (open && from == 'waiting' && to == 'ready')
            || (open && from == 'ready' && to == 'waiting')
            || (from != 'closed' && to == 'closed')
          )
        );
    }

    // Everything else stays closed until a feature needs it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
